# Configuración del Servidor Orquestador Neuroph-Train
# Despliegue en VPS (Dokploy)

# Puerto TCP expuesto para recibir conexiones de los Workers
SERVER_PORT=9000

# Token secreto para que el Administrador pueda subir datasets y lanzar campañas
ADMIN_TOKEN=secret-orquitas-2026

# Ruta del volumen persistente donde se guardan datasets y modelos .nnet
STORAGE_DIR=/app/storage

# Tiempo máximo en segundos de inactividad de Heartbeat antes de desconectar un worker
HEARTBEAT_TIMEOUT=15
